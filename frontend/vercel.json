{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[...path]?path=:path*" },
    { "source": "/requests", "destination": "/requests.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/ceo", "destination": "/ceo.html" },
    { "source": "/ceo.html", "destination": "/ceo.html" },
    { "source": "/customer-register", "destination": "/customer-register.html" },
    { "source": "/register", "destination": "/customer-register.html" },
    { "source": "/((?!api\\/.*|.*\\.html$).*)", "destination": "/index.html" }
  ]
}
